generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id            String   @id @default(uuid())
  customerName  String
  customerEmail String
  totalAmount   Float
  costAmount    Float
  status        String   @default("PENDING") // 'PENDING' | 'PROCESSING' | 'SHIPPED' | 'DELIVERED'
  itemsCount    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Product {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  price     Float
  cost      Float
  stock     Int
  category  String
  createdAt DateTime @default(now())
}
